{
  "manifest_version": 3,
  "name": "Lector Inglés - Vocabulario y Quiz",
  "version": "1.3.0",
  "description": "Traduce palabras y párrafos en inglés al navegar, escucha su pronunciación nativa y practica tu vocabulario con Quiz interactivos.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Lector Inglés - Vocabulario",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["offline_dict.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["offline_dict.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://clients5.google.com/*",
    "https://translate.googleapis.com/*",
    "https://*.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "lector-ingles@alfredo.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
